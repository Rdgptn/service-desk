# Copie como .env e troque os valores de exemplo. Não publique esse arquivo.
PORT=3000

# PostgreSQL local; a senha precisa ser igual nos dois campos.
POSTGRES_DB=ponto
POSTGRES_USER=ponto
POSTGRES_PASSWORD=troque-esta-senha-local
POSTGRES_PORT=5432
DATABASE_URL=postgres://ponto:troque-esta-senha-local@127.0.0.1:5432/ponto

# Cadastro local: informe o domínio usado nos e-mails corporativos, sem @.
# Separe múltiplos domínios por vírgula. Isso não verifica a posse da caixa postal.
ALLOWED_EMAIL_DOMAINS=

# Conta admin inicial criada pelo servidor se ainda não existir admin local.
# Após a primeira inicialização, retire INITIAL_ADMIN_PASSWORD do .env; o hash fica no banco.
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Gere um valor aleatório longo e único; mantenha-o estável entre reinicializações.
# Pode usar: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=SUBSTITUA-POR-UM-SEGREDO-ALEATORIO-DE-96-HEXADECIMAIS
# Para localhost use false/lax. Em HTTPS embutido no Preview use true/none.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
# Em Preview HTTPS embutido configure TRUST_PROXY=1, SECURE=true e SAMESITE=none.
TRUST_PROXY=0
